# Gmail SMTP account used to send access codes.
# Without these the app runs in demo mode and shows the code on screen.
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# Comma-separated list of addresses allowed through the access gate.
# Leave empty to allow any valid email address (local development).
AUTHORIZED_EMAILS=

# Signs dashboard session tokens. Set a long random value in production,
# otherwise a new one is generated per process and everyone is logged out on
# restart. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
SESSION_TTL_SECONDS=43200

# Long-lived token for Power BI / other unattended readers of
# /api/export/csv?token=... . Leave empty to require an interactive session.
EXPORT_TOKEN=

# Firestore (optional). Without it the app uses the local SQLite database.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_COLLECTION=loan_records
FIREBASE_VERIFICATIONS_COLLECTION=verification_codes
