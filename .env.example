# Gmail SMTP account used to send access codes.
# Without these the app runs in demo mode and shows the code on screen.
SMTP_EMAIL=
SMTP_PASSWORD=

# Comma-separated list of addresses allowed through the access gate.
# Leave empty to allow any valid email address (local development).
AUTHORIZED_EMAILS=

# Firestore (optional). Without it the app uses the local SQLite database.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_COLLECTION=loan_records
FIREBASE_VERIFICATIONS_COLLECTION=verification_codes
